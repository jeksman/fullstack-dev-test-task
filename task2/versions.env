# ghost-hetzner-oneclick — pinned version matrix
# Verified against official documentation on 2026-08-28. See docs/version-matrix.md.

# --- Server OS -------------------------------------------------------------
# Ghost officially supports Ubuntu 22.04 / 24.04 / 26.04. 24.04 LTS is the
# conservative production choice (MySQL 8.0 in main, 5y standard support).
GHO_IMAGE="ubuntu-24.04"

# --- Node.js ---------------------------------------------------------------
# Ghost >= 6.0.0 requires ^22.13.1 (Node v22 "Jod" LTS). 20.x and 24.x are
# explicitly unsupported. Installed from the NodeSource deb repository.
GHO_NODE_MAJOR="22"

# --- Ghost -----------------------------------------------------------------
# Ghost-CLI 1.x is the current generation; pinned to a major range so a future
# 2.x cannot silently change the CLI contract this installer depends on.
GHO_GHOST_CLI_SPEC="ghost-cli@^1.28.0"
GHO_GHOST_MAJOR="6"

# --- MySQL -----------------------------------------------------------------
# Ghost supports MySQL 8.0 or 8.4. Ubuntu 24.04 ships 8.0.x in main.
GHO_MYSQL_PACKAGE="mysql-server-8.0"
GHO_MYSQL_MIN="8.0"

# --- Local helper binaries -------------------------------------------------
GHO_HCLOUD_VERSION="1.67.0"
GHO_JQ_VERSION="1.8.2"

# --- Tailscale -------------------------------------------------------------
# Server side installs from pkgs.tailscale.com (always current stable).
# This value only documents the release this project was verified against.
GHO_TAILSCALE_VERIFIED="1.102.3"

# --- Hetzner defaults ------------------------------------------------------
GHO_DEFAULT_SERVER_TYPE="cx23"
GHO_DEFAULT_LOCATION="nbg1"
GHO_MIN_MEMORY_GB="2"
